    "views": [
      {
        "viewName": "visible_channels",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT * FROM channels c WHERE c.playlistId IN (SELECT id FROM playlists WHERE enabled = 1)\n               AND NOT EXISTS (SELECT 1 FROM hidden_groups h\n               WHERE h.playlistId = c.playlistId AND h.kind = 'LIVE' AND h.name = c.groupTitle)\n               AND NOT EXISTS (SELECT 1 FROM locked_groups l\n               WHERE l.playlistId = c.playlistId AND l.kind = 'LIVE' AND l.name = c.groupTitle)"
      },
      {
        "viewName": "visible_vod",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT * FROM vod v WHERE v.playlistId IN (SELECT id FROM playlists WHERE enabled = 1)\n               AND NOT EXISTS (SELECT 1 FROM hidden_groups h\n               WHERE h.playlistId = v.playlistId AND h.kind = 'VOD' AND h.name = v.category)\n               AND NOT EXISTS (SELECT 1 FROM locked_groups l\n               WHERE l.playlistId = v.playlistId AND l.kind = 'VOD' AND l.name = v.category)"
      },
      {
        "viewName": "visible_series",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT * FROM series s WHERE s.playlistId IN (SELECT id FROM playlists WHERE enabled = 1)\n               AND NOT EXISTS (SELECT 1 FROM hidden_groups h\n               WHERE h.playlistId = s.playlistId AND h.kind = 'SERIES' AND h.name = s.category)\n               AND NOT EXISTS (SELECT 1 FROM locked_groups l\n               WHERE l.playlistId = s.playlistId AND l.kind = 'SERIES' AND l.name = s.category)"
      }
    ],
